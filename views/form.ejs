<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Request Verification Code</title>
  </head>
  <body>
    <div style="max-width: 400px; margin: 50px auto; font-family: sans-serif">
      <h1>Sign Up / Verify Email</h1>
      <p>Enter your email to receive a secure 6-digit confirmation code.</p>
      <form action="/send-email" method="POST">
        <div style="margin-bottom: 15px">
          <label for="to" style="display: block; margin-bottom: 5px"
            >Email Address:</label
          >
          <input
            type="email"
            id="to"
            name="to"
            required
            style="width: 100%; padding: 8px; box-sizing: border-box"
          />
        </div>
        <button
          type="submit"
          style="
            padding: 10px 15px;
            background: #007bff;
            color: white;
            border: none;
            cursor: pointer;
            width: 100%;
          "
        >
          Send Verification Code
        </button>
      </form>
    </div>
  </body>
</html>
