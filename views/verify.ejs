<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Enter Verification Code</title>
  </head>
  <body>
    <div style="max-width: 400px; margin: 50px auto; font-family: sans-serif;">
      <h1>Enter Verification Code</h1>
      <p>We sent a 6-digit secure code to <strong><%= email %></strong>.</p>

      <% if (errorMessage) { %>
        <div style="color: red; background: #fdf2f2; padding: 10px; margin-bottom: 15px; border: 1px solid red;">
          <%= errorMessage %>
        </div>
      <% } %>

      <form action="/verify-otp" method="POST">
        <!-- Hidden input tracks the user email alongside their code submission -->
        <input type="hidden" name="email" value="<%= email %>" />
        
        <div style="margin-bottom: 15px;">
          <label for="otp" style="display: block; margin-bottom: 5px;">6-Digit Code:</label>
          <input type="text" id="otp" name="otp" required maxlength="6" pattern="\d{6}" placeholder="123456" style="width: 100%; padding: 8px; box-sizing: border-box; text-align: center; font-size: 18px; letter-spacing: 4px;" />
        </div>
        <button type="submit" style="padding: 10px 15px; background: #28a745; color: white; border: none; cursor: pointer; width: 100%;">
          Verify Code
        </button>
      </form>
      <p style="text-align: center; margin-top: 15px;"><a href="/">Back to login</a></p>
    </div>
  </body>
</html>
